# === PostgreSQL ===
POSTGRES_USER=sp_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=smart_port_db
POSTGRES_PORT=5432

# === Backend (FastAPI) ===
BACKEND_PORT=8000
SECRET_KEY=change_me_super_secret_key
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# === AI Service ===
# 0 = webcam locale ; sinon chemin/URL RTSP du flux caméra du portique
# Sous Windows + Docker Desktop, la webcam USB n'est PAS accessible depuis un
# conteneur (pas de passthrough device) : utilise plutôt un fichier vidéo de
# test placé dans le dossier ./media/ (à la racine du projet, partagé entre
# backend et ai-service via bind-mount) et mets ici son chemin, ex:
# VIDEO_SOURCE=/app/media/test.mp4
VIDEO_SOURCE=0
YOLO_VEHICLE_MODEL=yolov8n.pt
# Modèle plaque pré-entraîné (MIT) — voir ai_service/scripts/download_plate_model.sh
YOLO_PLATE_MODEL=models/plate_detector.pt
OCR_LANGUAGES=en
DETECTION_CONFIDENCE=0.45
# Sans GPU : garder FRAME_SKIP élevé (on traite 1 frame sur N) pour rester fluide
FRAME_SKIP=5
GATE_ID=GATE_A_ENTRY
CAPTURE_INTERVAL_SECONDS=1.0

# === Dashboard (Streamlit) ===
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SECONDS=5
